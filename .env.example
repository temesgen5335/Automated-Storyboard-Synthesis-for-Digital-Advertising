# All optional — the app runs with ZERO keys (Pollinations + mock fallback).

# --- image source -----------------------------------------------------------
#   pollinations : generate images (keyless, FLUX) — default
#   openverse    : retrieve REAL, CC-licensed images/logos (keyless)
#   huggingface  : generate via HF Inference API (needs HF_TOKEN)
#   mock         : offline deterministic placeholders (no network)
ADSYNTH_IMAGE_PROVIDER=pollinations
# HF_TOKEN=hf_xxx                       # only if ADSYNTH_IMAGE_PROVIDER=huggingface
# ADSYNTH_HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# --- LLM for planner/critic agents: none (default) | gemini | groq | openrouter ---
ADSYNTH_LLM_PROVIDER=none
# GEMINI_API_KEY=...                    # free tier: https://aistudio.google.com/apikey
# GROQ_API_KEY=...                      # free tier: https://console.groq.com
# OPENROUTER_API_KEY=...                # free models: https://openrouter.ai

# --- behaviour ---
ADSYNTH_SEED=42
ADSYNTH_TIMEOUT=60
